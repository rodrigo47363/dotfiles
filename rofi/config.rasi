configuration {
    /* --- 1. CORE --- */
    modes: "drun,run,window,ssh,combi";
    combi-modes: "drun,run";
    terminal: "kitty";
    
    /* Usamos el flag --hold para herramientas de CLI */
    run-command: "{cmd}";
    run-shell-command: "{terminal} --hold -e {cmd}";
    ssh-command: "{terminal} -e ssh {host}";

    /* --- 2. MOTOR DE BÚSQUEDA Y RENDIMIENTO --- */
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    drun-match-fields: "name,generic,exec,categories,keywords";
    drun-use-desktop-cache: false;
    max-history-size: 0; /* Deshabilitado por seguridad (OPSEC) */

    /* --- 3. OPSEC --- */
    disable-history: true; 

    /* --- 4. UI / APARIENCIA --- */
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Papirus"; 
    
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: " 󰕰  Window ";
    display-ssh: " 󰣀  SSH ";
    display-combi: " 󰕘  Combi ";
    
    drun-display-format: "{icon} {name} <span weight='light' size='small'><i>({generic})</i></span>";
    window-format: "{w} · {c} · {t}";
    sidebar-mode: true;

    /* --- 5. KEYBINDINGS (Vim-like estricto) --- */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    
    kb-remove-char-back: "BackSpace,Shift+BackSpace"; 
    kb-remove-to-eol: "Control+Shift+e";
    kb-mode-complete: ""; 
    
    kb-row-up: "Up,Control+k";
    kb-row-down: "Down,Control+j";
    kb-accept-entry: "Control+m,Return,KP_Enter";
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
    
    /* Mejora de usabilidad en Tiling Managers */
    kb-cancel: "Escape,Control+g,Control+bracketleft";
}

@theme "~/.config/rofi/themes/neo_tokyo.rofi"
