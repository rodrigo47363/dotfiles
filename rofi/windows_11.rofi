/************************************************
 * ROFI Windows 11 Authentic Start Menu Theme
 * windows_11.rofi BY Rodrigo47363
 * https://github.com/rodrigo47363
 * Style: 100% Genuine Windows 11 Sun Valley & Mica Material
 ***********************************************/

configuration {
    font:                "Segoe UI Variable 10";
    show-icons:          true;
    icon-theme:          "We10X-dark";
    display-drun:        "";
    display-run:         "";
    display-window:      "";
    drun-display-format: "{name}";
}

* {
    /* Paleta Oficial Windows 11 Dark Mode (Mica Material) */
    bg0:         #1f1f1ff6; /* Fondo Mica translúcido (~96% opacidad) */
    bg1:         #2b2b2b;   /* Caja de búsqueda estilo cápsula Fluent */
    fg0:         #ffffff;   /* Blanco puro para texto y títulos */
    fg1:         #8c8c8c;   /* Gris neutro para placeholder e iconos secundarios */
    accent:      #60cdff;   /* Luminous Fluent Blue (Windows 11 Dark Accent) */
    border-col:  #ffffff1f; /* Borde perimetral de cristal translúcido (12% blanco) */
    urgent:      #ff99a4;   /* Rojo de alerta Fluent */

    background-color:   transparent;
    text-color:         @fg0;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    background-color:   @bg0;
    border:             1px;
    border-color:       @border-col;
    border-radius:      14px; /* Esquinas redondeadas suaves firma de Windows 11 */
    width:              650px;
    padding:            20px;
    location:           south; /* Ventana flotante centrada moderna */
    anchor:             south;
    y-offset:           -50;
}

mainbox {
    children:           [ inputbar, textbox-pinned, listview, footer ];
}

/* --- Barra de Búsqueda estilo Cápsula (Search Pill) --- */
inputbar {
    background-color:   @bg1;
    border:             1px;
    border-color:       #383838;
    border-radius:      22px; /* Cápsula pill idéntica a Windows 11 */
    padding:            8px 16px;
    margin:             0px 0px 14px 0px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @fg1;
    font:               "JetBrainsMono Nerd Font 11";
    margin:             0px 8px 0px 2px;
    vertical-align:     0.5;
}

entry {
    background-color:   transparent;
    text-color:         @fg0;
    placeholder:        "Escribe aquí para buscar...";
    placeholder-color:  @fg1;
    vertical-align:     0.5;
}

/* --- Encabezado de la Sección de Apps Fijadas --- */
textbox-pinned {
    expand:             false;
    str:                "  Anclado";
    font:               "Segoe UI Variable Bold 10";
    text-color:         @fg0;
    padding:            4px 2px 10px 2px;
}

/* --- Cuadrícula de Aplicaciones Pinned (6 Columnas) --- */
listview {
    columns:            6;
    lines:              3;
    cycle:              true;
    dynamic:            true;
    layout:             vertical;
    flow:               horizontal;
    fixed-columns:      true;
    spacing:            8px;
    scrollbar:          false;
    margin:             0px 0px 14px 0px;
}

element {
    orientation:        vertical;
    padding:            12px 6px;
    border-radius:      8px;
    cursor:             pointer;
}

element normal.normal {
    background-color:   transparent;
    text-color:         #dcdcdc;
}

/* Efecto Fluent Hover / Selección: Fondo translúcido sutil con borde fino */
element selected.normal {
    background-color:   #ffffff14;
    text-color:         #ffffff;
    border:             1px;
    border-color:       #ffffff20;
}

element-icon {
    size:               40px; /* Icono grande centrado arriba del texto */
    horizontal-align:   0.5;
    vertical-align:     0.5;
    margin:             0px 0px 6px 0px;
    cursor:             inherit;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    background-color:   inherit;
    text-color:         inherit;
    cursor:             inherit;
}

/* --- Barra Inferior del Menú de Inicio (Usuario + Apagado) --- */
footer {
    expand:             false;
    orientation:        horizontal;
    background-color:   #171717cc;
    border:             1px;
    border-color:       #ffffff10;
    border-radius:      8px;
    padding:            10px 16px;
    margin:             2px 0px 0px 0px;
    children:           [ textbox-user, textbox-power ];
}

textbox-user {
    expand:             true;
    str:                "  Rodrigo";
    font:               "Segoe UI Variable Semibold 10";
    text-color:         #f0f0f0;
    vertical-align:     0.5;
}

textbox-power {
    expand:             false;
    str:                "⏻ ";
    font:               "Roboto 12";
    text-color:         #cccccc;
    vertical-align:     0.5;
}

/* FIX: Reset estricto para anular fondos blancos de fábrica */
element.normal.normal, element.alternate.normal, element.alternate.urgent, element.alternate.active {
    background-color: transparent;
    text-color: inherit;
}
