#! /bin/sh

# ==========================================
# 1. ENTORNO Y FIXES
# ==========================================
# Cambiamos wmname para compatibilidad con aplicaciones Java (ej: BurpSuite)
wmname LG3D &
[ -f "$HOME/.Xmodmap" ] && xmodmap "$HOME/.Xmodmap"
numlockx off 2>/dev/null || xset -led named "Num Lock" 2>/dev/null || true
rm -f /run/user/$UID/rofi*.pid /tmp/rodrigo47363-rofi.lock 2>/dev/null || true

# ==========================================
# 2. CONFIGURACIÓN BSPWM
# ==========================================
bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width        2  
bspc config window_gap         12
bspc config split_ratio         0.52
bspc config borderless_monocle  true
bspc config gapless_monocle     true
bspc config focus_follows_pointer true
bspc config normal_border_color "#4c566a"
bspc config active_border_color "#88c0d0"
bspc config focused_border_color "#81a1c1"

# Reglas de Pentesting: Fuerza herramientas a escritorios específicos y estados
bspc rule -a BurpSuite desktop='^10' state=tiled follow=on
bspc rule -a Gimp state=floating follow=on
bspc rule -a resolve state=floating follow=on
bspc rule -a mpv state=floating
bspc rule -a Screenkey manage=off
bspc rule -a "OsdSlider_volume" state=floating border=off focus=on
bspc rule -a "OsdSlider_brightness" state=floating border=off focus=on
bspc rule -a taskmanager state=floating rectangle=1050x700+435+190 center=on follow=on

# ==========================================
# 3. AUTOARRANQUE (Gestión limpia de procesos)
# ==========================================
# sxhkd: Inicia limpiamente
pkill -9 -x sxhkd 2>/dev/null || true
sxhkd -c "$HOME/.config/sxhkd/sxhkdrc" &

# Compositor picom
if ! pgrep -x picom >/dev/null; then
    picom --config ~/.config/picom/picom.conf -b
fi

# Agente Polkit
if ! pgrep -x lxpolkit >/dev/null; then
    lxpolkit &
fi

# Demonio de Notificaciones (Dunst)
if which dunst >/dev/null 2>&1; then
    killall -q dunst 2>/dev/null || true
    dunst -config "$HOME/.config/dunst/dunstrc" &
fi

# ==========================================
# 4. HARDWARE E INTERFAZ
# ==========================================
# Tapping persistente (Tap-to-click) y desplazamiento natural
for dev_id in $(xinput list --id-only 2>/dev/null); do
    if xinput list-props "$dev_id" 2>/dev/null | grep -q "libinput Tapping Enabled"; then
        xinput set-prop "$dev_id" "libinput Tapping Enabled" 1 2>/dev/null
        xinput set-prop "$dev_id" "libinput Natural Scrolling Enabled" 1 2>/dev/null
    fi
done

# Wallpaper y Barra
[ -f "$HOME/.fehbg" ] && "$HOME/.fehbg" &
$HOME/.config/polybar/launch.sh &
